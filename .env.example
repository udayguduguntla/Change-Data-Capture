# ==============================================================================
# CDC Knowledge Graph Pipeline - Environment Configuration Template
# Copy this file to .env and supply your environment-specific credentials.
# ==============================================================================

# ---- PostgreSQL (CDC Source) ------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=your_database_name
PG_USER=your_postgres_user
PG_PASSWORD=your_postgres_password

# Internal address used by Debezium when running inside Docker container
DEBEZIUM_PG_HOST=postgres
DEBEZIUM_PG_PORT=5432

# ---- Kafka & Debezium Connect -----------------------------------------------
KAFKA_BOOTSTRAP=localhost:9092
CONNECT_URL=http://localhost:8083

# ---- Neo4j (Graph Target - Enterprise Required) ------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ---- Embedding Worker -------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu

# ---- Metrics & Health -------------------------------------------------------
METRICS_PORT=9109
